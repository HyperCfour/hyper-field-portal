# Copy to .env.local for local runs. Never commit real values.
# monday service account token with access to the HYPER // Network Operations workspace.
MONDAY_TOKEN=
# Access codes, one per portal. Changing a code signs that portal's devices out.
PORTAL_CODE_MOBIL=
PORTAL_CODE_FOURSQUARE=
PORTAL_CODE_LIQUORLAND=
PORTAL_CODE_BRISCOE_GROUP=
# Fallback for any portal without its own code. Handy locally; leave unset in production.
PORTAL_CODE=
